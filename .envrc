# direnv config — auto-activates the project venv and loads .env when you cd in.
#
# One-time setup (per machine):
#   brew install direnv                                   # or your package manager
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc          # bash: direnv hook bash
#   exec $SHELL                                           # reload the shell
# Then, in this folder:
#   direnv allow                                          # approve this .envrc once
#
# direnv is optional: every `make` target uses .venv/bin/python directly, so the
# project works without it. This just spares you `source .venv/bin/activate`.

if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$PWD/.venv/bin"
else
  log_status "No .venv yet — run 'make setup' to create it."
fi

# Load .env into the shell environment (no-op if the file is absent). The app
# also loads .env via python-dotenv, so this is purely for interactive shells.
dotenv_if_exists .env
